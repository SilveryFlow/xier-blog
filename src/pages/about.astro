---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from '../components/DarkModeToggle.vue';
---

<BaseLayout title="关于我 - XIER's Blog">
  <div class="max-w-2xl mx-auto">
    <section class="text-center py-8">
      <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white text-4xl font-bold">
        X
      </div>
      <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">关于 XIER</h1>
      <p class="text-gray-600 dark:text-gray-300">前端开发者 / 技术博主 / 终身学习者</p>
      <div class="mt-4 flex justify-center">
        <DarkModeToggle client:load />
      </div>
    </section>

    <section class="card mb-6">
      <h2 class="text-xl font-bold mb-4">简介</h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        你好！我是一名热爱技术的前端开发者，专注于现代 Web 技术栈。
        我对新技术充满好奇，喜欢折腾各种开发工具和框架。
      </p>
    </section>

    <section class="card mb-6">
      <h2 class="text-xl font-bold mb-4">技术栈</h2>
      <div class="flex flex-wrap gap-2">
        {['Vue', 'React', 'TypeScript', 'Astro', 'Node.js', 'TailwindCSS', 'UnoCSS'].map((tech) => (
          <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded-full text-sm">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <section class="card mb-6">
      <h2 class="text-xl font-bold mb-4">联系方式</h2>
      <div class="space-y-2 text-gray-600 dark:text-gray-300">
        <p>📧 Email: ccy86211@gmail.com</p>
        <p>🐙 GitHub: github.com/ccy86211</p>
      </div>
    </section>

    <section class="card">
      <h2 class="text-xl font-bold mb-4">关于这个博客</h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        这个博客使用 Astro + Vue 3 + UnoCSS 构建，部署在 Vercel 上。
        它是一个移动端优先的响应式设计，致力于提供最佳的阅读体验。
      </p>
    </section>
  </div>
</BaseLayout>
