---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我 - XIER's Blog">
  <div class="max-w-2xl mx-auto space-y-8">
    <!-- Avatar & Title -->
    <section class="text-center py-6">
      <div class="inline-flex items-center justify-center w-28 h-28 mb-6 rounded-full bg-gradient-to-br from-primary-400 via-primary-500 to-primary-600 shadow-xl">
        <span class="text-5xl font-bold text-white">X</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-gray-900 dark:text-gray-100">关于 XIER</h1>
      <p class="text-gray-600 dark:text-gray-300">前端开发者 / 技术博主 / 终身学习者</p>
    </section>

    <!-- Introduction -->
    <section class="card">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
        <span class="text-2xl">👋</span> 简介
      </h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        你好！我是一名热爱技术的前端开发者，专注于现代 Web 技术栈。
        我对新技术充满好奇，喜欢折腾各种开发工具和框架。
      </p>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-4">
        在这个博客里，你会看到关于前端开发的技术分享、项目经验以及一些生活随想。
        如果有任何问题或建议，欢迎联系我！
      </p>
    </section>

    <!-- Skills -->
    <section class="card">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
        <span class="text-2xl">🛠️</span> 技术栈
      </h2>
      <div class="flex flex-wrap gap-2">
        {[
          { name: 'Vue', color: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' },
          { name: 'React', color: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400' },
          { name: 'TypeScript', color: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400' },
          { name: 'Astro', color: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400' },
          { name: 'Node.js', color: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' },
          { name: 'TailwindCSS', color: 'bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-400' },
          { name: 'UnoCSS', color: 'color: #fef08a; background: #fef9c3; --tw-prose-links: #ca8a04; --tw-prose-emphasis: #a16207; --tw-prose-strong: #854d0e; --tw-prose-code: #854d0e; --tw-prose-pre-code: #422006; --tw-prose-pre-bg: #fef3c7; --tw-prose-th-borders: #d97706; --tw-prose-td-borders: #f59e0b' },
          { name: 'Git', color: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400' },
          { name: 'Vercel', color: 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300' }
        ].map((tech) => (
          <span class={`px-3 py-1.5 rounded-full text-sm font-medium ${tech.color}`}>
            {tech.name}
          </span>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section class="card">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
        <span class="text-2xl">📬</span> 联系方式
      </h2>
      <div class="space-y-3">
        <a href="mailto:ccy86211@gmail.com" class="flex items-center gap-3 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>ccy86211@gmail.com</span>
        </a>
        <a href="https://github.com/ccy86211" target="_blank" rel="noopener" class="flex items-center gap-3 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>github.com/ccy86211</span>
        </a>
      </div>
    </section>

    <!-- About Blog -->
    <section class="card">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
        <span class="text-2xl">🚀</span> 关于这个博客
      </h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        这个博客使用 <strong class="text-primary-600 dark:text-primary-400">Astro</strong> + 
        <strong class="text-primary-600 dark:text-primary-400">Vue 3</strong> + 
        <strong class="text-primary-600 dark:text-primary-400">UnoCSS</strong> 构建，
        部署在 Vercel 上。
      </p>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-4">
        它是一个移动端优先的响应式设计，致力于提供最佳的阅读体验。
        采用暗色模式支持，让你在夜间阅读也能保护眼睛。
      </p>
    </section>
  </div>
</BaseLayout>
