        {post.title}
      </h1>
      <div class="flex items-center gap-4">
        <DarkModeToggle client:load />
      </div>
    </header>
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <div set:html={post.content.replace(/---[\s\S]*?---/, '').replace(/^# /gm, '<h1 class="text-2xl font-bold mt-8 mb-4">').replace(/^## /gm, '<h2 class="text-xl font-bold mt-6 mb-3">').replace(/^### /gm, '<h3 class="text-lg font-semibold mt-4 mb-2">').replace(/<h1 class="text-2xl font-bold mt-8 mb-4">/g, '</div><h1 class="text-2xl font-bold mt-8 mb-4">').replace(/<h2 class="text-xl font-bold mt-6 mb-3">/g, '</div><h2 class="text-xl font-bold mt-6 mb-3">').replace(/<h3 class="text-lg font-semibold mt-4 mb-2">/g, '</div><h3 class="text-lg font-semibold mt-4 mb-2">').replace(/\n\n/g, '</p><p class="my-4">').replace(/`([^`]+)`/g, '<code class="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-sm">$1</code>').replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg overflow-x-auto my-4"><code>$2</code></pre>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\*([^*]+)\*/g, '<em>$1</em>').replace(/^- /gm, '<li class="ml-4">') + '</p>'} />
    </div>
    
    <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a href="/blog" class="text-primary-600 dark:text-primary-400 hover:underline">
        ← 返回文章列表
      </a>
    </footer>
  </article>
</BaseLayout>

