const { post } = Astro.props;

// Unescape backticks first, then strip frontmatter
const unescapedContent = post.content.replace(/\\`/g, '`');
const rawContent = unescapedContent.replace(/^---[\s\S]*?---\n?/, '');

// Extract code blocks and replace with placeholders
let codeBlockIndex = 0;
const codeBlocks: { lang: string; code: string; index: number }[] = [];

const contentWithPlaceholders = rawContent.replace(
  /```(\w+)?\n([\s\S]*?)```/g,
  (_, lang, code) => {
    const index = codeBlockIndex++;
    codeBlocks.push({ lang: lang || 'text', code: code.trim(), index });
    return `<pre data-code-block-index="${index}"></pre>`;
  }
);

// Initialize markdown-it
const md = new MarkdownIt({
  html: true,
  typographer: true,
  linkify: true,
  breaks: false
});

const renderedHtml = md.render(contentWithPlaceholders);

// Highlight code blocks with shiki
const highlightedCodeBlocks = await Promise.all(
  codeBlocks.map(async ({ lang, code, index }) => {
    const normalizedLang = lang.toLowerCase();
    const shikiLang =
      normalizedLang in bundledLanguages ? normalizedLang : 'text';
    
    try {
      const html = await codeToHtml(code, {
        lang: shikiLang,
        theme: 'github-dark',
        transformers: []
      });
      return { index, html };
    } catch {
      const escapedCode = code
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      return {
        index,
        html: `<pre class="shiki-code-block rounded-lg p-4 overflow-x-auto my-4 text-sm font-mono relative group bg-gray-900 border border-gray-700"><code>${escapedCode}</code></pre>`
      };
    }
  })
);

// Replace placeholders with highlighted code
let finalHtml = renderedHtml;
for (const { index, html } of highlightedCodeBlocks) {
  finalHtml = finalHtml.replace(
    `<pre data-code-block-index="${index}"></pre>`,
    html
  );
}
