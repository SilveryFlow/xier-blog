---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    slug: 'welcome',
    title: '欢迎来到我的博客',
    pubDate: '2024-01-15',
    description: '这是我的第一篇博客文章，介绍一下这个博客的由来和目的。',
    tags: ['博客', '入门']
  },
  {
    slug: 'astro-vue-integration',
    title: 'Astro 与 Vue 3 的完美结合',
    pubDate: '2024-01-20',
    description: '探索如何在 Astro 中使用 Vue 3 构建高性能的动态组件。',
    tags: ['Astro', 'Vue']
  },
  {
    slug: 'mobile-first-design',
    title: '移动端优先设计的最佳实践',
    pubDate: '2024-01-25',
    description: '探讨如何构建真正移动端优先的响应式网站设计。',
    tags: ['移动端', '响应式']
  }
];

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<BaseLayout title="文章列表 - XIER's Blog">
  <div class="space-y-8">
    <section class="text-center py-6 sm:py-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3 bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">
        所有文章
      </h1>
      <p class="text-gray-600 dark:text-gray-300">
        共 {posts.length} 篇文章
      </p>
    </section>

    <section>
      <div class="space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block card hover:shadow-lg hover:scale-[1.01] transition-all duration-200 no-underline">
            <article>
              <div class="flex items-center gap-3 mb-2">
                <time class="text-sm text-gray-500 dark:text-gray-400">{formatDate(post.pubDate)}</time>
                <div class="flex gap-2">
                  {post.tags.map((tag) => (
                    <span class="px-2 py-0.5 text-xs rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <h2 class="text-lg sm:text-xl font-semibold mb-2 text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                {post.title}
              </h2>
              <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">
                {post.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
