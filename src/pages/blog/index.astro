---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DarkModeToggle from '../../components/DarkModeToggle.vue';

const posts = [
  {
    slug: 'welcome',
    title: '欢迎来到我的博客',
    pubDate: '2024-01-15',
    description: '这是我的第一篇博客文章，介绍一下这个博客的由来和目的。'
  },
  {
    slug: 'astro-vue-integration',
    title: 'Astro 与 Vue 3 的完美结合',
    pubDate: '2024-01-20',
    description: '探索如何在 Astro 中使用 Vue 3 构建高性能的动态组件。'
  },
  {
    slug: 'mobile-first-design',
    title: '移动端优先设计的最佳实践',
    pubDate: '2024-01-25',
    description: '探讨如何构建真正移动端优先的响应式网站设计。'
  }
];
---

<BaseLayout title="文章列表 - XIER's Blog">
  <div class="space-y-8">
    <section class="text-center py-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 text-primary-600 dark:text-primary-400">
        所有文章
      </h1>
      <p class="text-gray-600 dark:text-gray-300">
        共 {posts.length} 篇文章
      </p>
      <div class="mt-4 flex justify-center">
        <DarkModeToggle client:load />
      </div>
    </section>

    <section>
      <div class="space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block card hover:shadow-lg transition-shadow">
            <article>
              <time class="text-sm text-gray-500 dark:text-gray-400">{post.pubDate}</time>
              <h2 class="text-xl font-semibold mt-2 mb-2 text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                {post.title}
              </h2>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                {post.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
