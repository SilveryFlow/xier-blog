---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    slug: 'welcome',
    title: '欢迎来到我的博客',
    pubDate: '2024-01-15',
    description: '这是我的第一篇博客文章，介绍一下这个博客的由来和目的。'
  },
  {
    slug: 'astro-vue-integration',
    title: 'Astro 与 Vue 3 的完美结合',
    pubDate: '2024-01-20',
    description: '探索如何在 Astro 中使用 Vue 3 构建高性能的动态组件。'
  },
  {
    slug: 'mobile-first-design',
    title: '移动端优先设计的最佳实践',
    pubDate: '2024-01-25',
    description: '探讨如何构建真正移动端优先的响应式网站设计。'
  }
];

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<BaseLayout title="XIER's Blog - 首页">
  <div class="space-y-10">
    <!-- Hero Section -->
    <section class="text-center py-8 sm:py-12">
      <div class="inline-flex items-center justify-center w-20 h-20 sm:w-24 sm:h-24 mb-6 rounded-full bg-gradient-to-br from-primary-400 via-primary-500 to-primary-600 shadow-lg">
        <span class="text-3xl sm:text-4xl font-bold text-white">X</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">
        你好，我是 XIER 👋
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-xl mx-auto px-4">
        前端开发者 / 技术博主 / 终身学习者
      </p>
      <div class="flex justify-center gap-4 mt-6">
        <a href="https://github.com/ccy86211" target="_blank" rel="noopener" 
           class="p-2.5 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-primary-100 dark:hover:bg-primary-900/30 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-all duration-200">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a href="/about" 
           class="px-5 py-2.5 rounded-full bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors duration-200 shadow-md hover:shadow-lg">
          了解更多
        </a>
      </div>
    </section>

    <!-- About Section -->
    <section class="card">
      <h2 class="text-xl sm:text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">关于我</h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        我是一名热爱技术的前端开发者，专注于现代 Web 技术栈。
        在这里，我会分享前端开发经验、项目心得以及生活感悟。
      </p>
    </section>

    <!-- Recent Posts -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">最新文章</h2>
        <a href="/blog" class="text-sm font-medium text-primary-600 dark:text-primary-400 ">
          查看全部 →
        </a>
      </div>
      
      <div class="space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block card hover:shadow-lg hover:scale-[1.01] transition-all duration-200">
            <article>
              <time class="text-sm text-gray-500 dark:text-gray-400">{formatDate(post.pubDate)}</time>
              <h3 class="text-lg sm:text-xl font-semibold mt-2 mb-2 text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                {post.title}
              </h3>
              <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">
                {post.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
