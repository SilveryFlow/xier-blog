---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from '../components/DarkModeToggle.vue';

const posts = [
  {
    slug: 'welcome',
    title: '欢迎来到我的博客',
    pubDate: '2024-01-15',
    description: '这是我的第一篇博客文章，介绍一下这个博客的由来和目的。'
  },
  {
    slug: 'astro-vue-integration',
    title: 'Astro 与 Vue 3 的完美结合',
    pubDate: '2024-01-20',
    description: '探索如何在 Astro 中使用 Vue 3 构建高性能的动态组件。'
  },
  {
    slug: 'mobile-first-design',
    title: '移动端优先设计的最佳实践',
    pubDate: '2024-01-25',
    description: '探讨如何构建真正移动端优先的响应式网站设计。'
  }
];
---

<BaseLayout title="XIER's Blog - 首页">
  <div class="space-y-8">
    <!-- Hero Section -->
    <section class="text-center py-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-primary-600 dark:text-primary-400">
        你好，我是 XIER 👋
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        前端开发者 / 技术博主 / 终身学习者
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <DarkModeToggle client:load />
      </div>
    </section>

    <!-- About Section -->
    <section class="card">
      <h2 class="text-2xl font-bold mb-4">关于我</h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
        我是一名热爱技术的前端开发者，专注于现代 Web 技术栈。
        在这里，我会分享前端开发经验、项目心得以及生活感悟。
      </p>
    </section>

    <!-- Recent Posts -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">最新文章</h2>
        <a href="/blog" class="text-primary-600 dark:text-primary-400 hover:underline text-sm font-medium">
          查看全部 →
        </a>
      </div>
      
      <div class="space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block card hover:shadow-lg transition-shadow">
            <article>
              <time class="text-sm text-gray-500 dark:text-gray-400">{post.pubDate}</time>
              <h3 class="text-xl font-semibold mt-2 mb-2 text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                {post.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                {post.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
