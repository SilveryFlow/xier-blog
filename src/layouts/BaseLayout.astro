---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A personal blog by XIER' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen">
    <header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-700">
      <nav class="max-w-3xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-bold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
            XIER's Blog
          </a>
          <div class="flex items-center gap-4">
            <a href="/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">首页</a>
            <a href="/blog" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">文章</a>
            <a href="/about" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">关于</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-700 mt-16">
      <div class="max-w-3xl mx-auto px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
        <p>&copy; 2024 XIER. All rights reserved.</p>
        <p class="mt-2">Powered by Astro + Vue + UnoCSS</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #0ea5e9;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  
  /* Mobile-first typography */
  @media (min-width: 640px) {
    body {
      font-size: 16px;
    }
  }
</style>
