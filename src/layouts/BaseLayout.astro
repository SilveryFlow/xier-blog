---
import DarkModeToggle from '../components/DarkModeToggle.vue';
import MobileMenu from '../components/MobileMenu.vue';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A personal blog by XIER' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700/50 shadow-sm">
      <nav class="max-w-4xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-bold bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent hover:opacity-80 transition-opacity">
            XIER's Blog
          </a>
          
          <!-- Desktop Nav -->
          <div class="hidden sm:flex items-center gap-6">
            <a href="/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">首页</a>
            <a href="/blog" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">文章</a>
            <a href="/about" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">关于</a>
            <DarkModeToggle client:load />
          </div>

          <!-- Mobile Nav -->
          <div class="flex sm:hidden items-center gap-3">
            <DarkModeToggle client:load />
            <MobileMenu client:load />
          </div>
        </div>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-6 sm:py-10">
      <slot />
    </main>

    <!-- Mobile Bottom Nav -->
    <nav class="sm:hidden fixed bottom-0 left-0 right-0 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md border-t border-gray-200 dark:border-gray-700/50 z-50 safe-area-bottom">
      <div class="flex items-center justify-evenly py-2">
        <a href="/" class="flex flex-col items-center gap-1 px-3 py-2 text-xs text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>首页</span>
        </a>
        <a href="/blog" class="flex flex-col items-center gap-1 px-3 py-2 text-xs text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>文章</span>
        </a>
        <a href="/about" class="flex flex-col items-center gap-1 px-3 py-2 text-xs text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>关于</span>
        </a>
      </div>
    </nav>

    <footer class="border-t border-gray-200 dark:border-gray-700/50 mt-12 mb-16 sm:mb-8">
      <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8 text-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">© 2024 XIER. All rights reserved.</p>
        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">Built with Astro + Vue + UnoCSS</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #0ea5e9;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Remove underlines from all links */
  a {
    text-decoration: none;
  }

  /* Safe area for mobile devices */
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  /* Improved mobile typography */
  @media (max-width: 640px) {
    body {
      font-size: 15px;
    }
  }

  /* Active nav state */
  nav a[aria-current="page"] {
    @apply text-primary-600 dark:text-primary-400;
  }
</style>
